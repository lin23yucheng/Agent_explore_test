{
  "schemaVersion": 1,
  "caseId": "CASE-000445",
  "caseContentHash": "30c539c808990c567b8ce0e06f15599fdcc74b5312fc5bf87031c086c57693ac",
  "title": "标签管理 - 编辑标签名称为空字符串的异常场景",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录系统且具有标签管理权限；存在一个已创建的标签，名称为“测试标签”，状态为启用；该标签未被任何任务使用。"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理列表页，找到目标标签“测试标签”。"
    },
    {
      "id": "S2",
      "text": "点击该标签所在行的“编辑”按钮。"
    },
    {
      "id": "S3",
      "text": "在编辑弹窗中，清空标签名称输入框。"
    },
    {
      "id": "S4",
      "text": "点击“确定”或“保存”按钮。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "标签管理列表页正常显示，目标标签可见。"
    },
    {
      "id": "A2",
      "text": "弹出编辑弹窗，标签名称输入框可编辑。"
    },
    {
      "id": "A3",
      "text": "输入框内容为空。"
    },
    {
      "id": "A4",
      "text": "保存失败，提示标签名称不能为空或长度必须在1到32之间。"
    }
  ],
  "contractHash": "1a8ee255ec561bb7b7433216fbce33b0e76549c71e60993edff6a22be9d59f4d",
  "completionGate": {
    "requiredCoverageIds": [
      "P1",
      "S1",
      "S2",
      "S3",
      "S4",
      "A1",
      "A2",
      "A3",
      "A4"
    ],
    "passRequiresCompleteCoverage": true
  }
}