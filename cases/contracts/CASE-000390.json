  "title": "标签管理 - 按标签名称模糊搜索",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录系统且具有标签管理权限；已存在至少两个标签，如“质量标签A”和“其他标签B”"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理页面；"
    },
    {
      "id": "S2",
      "text": "在标签名称输入框中输入“质量”；"
    },
    {
      "id": "S3",
      "text": "点击查询或等待自动搜索。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "标签管理页面正常显示；"
    },
    {
      "id": "A2",
      "text": "输入框可输入且内容正确；"
    },
    {
      "id": "A3",
      "text": "列表显示所有名称包含“质量”的标签，如“质量标签A”，不显示“其他标签B”。"
    }
  ],
