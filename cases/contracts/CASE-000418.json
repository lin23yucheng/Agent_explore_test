  "title": "标签管理 - 新建标签弹框点击取消关闭且不保存",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录VLA数据任务平台且具有标签管理权限；已进入标签管理页面"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "点击“新建标签”按钮，打开新建标签弹框"
    },
    {
      "id": "S2",
      "text": "在弹框中输入标签名称（如“测试标签”）并选择分类（如“质量”）"
    },
    {
      "id": "S3",
      "text": "点击“取消”按钮"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "新建标签弹框正常打开，显示标签名称输入框和分类选择框"
    },
    {
      "id": "A2",
      "text": "输入和选择操作正常完成"
    },
    {
      "id": "A3",
      "text": "弹框关闭，页面不新增任何标签，列表数据无变化"
    }
  ],
