  "title": "标签管理 - 新增标签时选择分类为质量",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录系统且具有标签管理权限；标签管理列表页已打开"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "点击“新增标签”按钮"
    },
    {
      "id": "S2",
      "text": "在标签名称输入框输入“测试标签A”"
    },
    {
      "id": "S3",
      "text": "在标签分类下拉框中选择“质量”"
    },
    {
      "id": "S4",
      "text": "点击“确定”按钮"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "弹出新增标签对话框"
    },
    {
      "id": "A2",
      "text": "标签名称输入成功"
    },
    {
      "id": "A3",
      "text": "分类下拉框显示“质量”且被选中"
    },
    {
      "id": "A4",
      "text": "新增成功，列表中出现该标签，分类显示为“质量”"
    }
  ],
  "contractHash": "f9ea1ed8be725a0cf745008459527bc379bc55e75d88a0505fef3213fccf6081",
