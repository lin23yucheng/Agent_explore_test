  "title": "标签管理 - 按启用状态查询仅显示启用标签",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录系统且具有标签管理权限；系统中存在至少一个状态为“启用”的标签和一个状态为“禁用”的标签"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理页面"
    },
    {
      "id": "S2",
      "text": "点击状态筛选下拉框"
    },
    {
      "id": "S3",
      "text": "选择“启用”选项"
    },
    {
      "id": "S4",
      "text": "点击查询按钮"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "标签管理页面正常显示标签列表"
    },
    {
      "id": "A2",
      "text": "下拉框展开，显示“启用”和“禁用”选项"
    },
    {
      "id": "A3",
      "text": "下拉框选中“启用”"
    },
    {
      "id": "A4",
      "text": "列表仅显示状态为“启用”的标签，不显示“禁用”标签"
    }
  ],
  "contractHash": "3aaee8e748163021d8f70feadfb17947f312a16dfad2c8af1aa75460717557fb",
