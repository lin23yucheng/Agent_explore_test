{
  "schemaVersion": 1,
  "caseId": "CASE-000452",
  "caseContentHash": "56f53694c100b6e8a0f6b7eae47f73957e0a08a8620653b71c59775df882cfe4",
  "title": "标签管理 - 已被任务使用的标签编辑时提示不允许修改",
  "preconditions": [
    {
      "id": "P1",
      "text": "存在一个标签（如：标签A），该标签已被至少一个任务引用；当前用户具有标签管理编辑权限；已登录系统并进入标签管理列表页。"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "在标签管理列表页中，找到已被任务使用的标签A；"
    },
    {
      "id": "S2",
      "text": "点击标签A所在行的“编辑”按钮；"
    },
    {
      "id": "S3",
      "text": "在编辑弹窗中，尝试修改标签名称或分类；"
    },
    {
      "id": "S4",
      "text": "点击“确定”或“保存”按钮。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "列表页正常显示标签A，且其状态为启用或禁用；"
    },
    {
      "id": "A2",
      "text": "系统弹出编辑弹窗，显示标签A的当前信息；"
    },
    {
      "id": "A3",
      "text": "编辑弹窗中可修改字段，但保存时被拦截；"
    },
    {
      "id": "A4",
      "text": "系统提示“标签已被任务使用，不允许修改”，且标签A的信息未被修改。"
    }
  ],
  "contractHash": "6ea961cbefe3fddeca8ee26ccf8ef002a1584000cee8066d9f945ca9fc3944e2",
  "completionGate": {
    "requiredCoverageIds": [
      "P1",
      "S1",
      "S2",
      "S3",
      "S4",
      "A1",
      "A2",
      "A3",
      "A4"
    ],
    "passRequiresCompleteCoverage": true
  }
}