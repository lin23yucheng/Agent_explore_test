  "title": "标签管理 - 禁用已被任务使用的标签时提示不允许禁用",
  "preconditions": [
    {
      "id": "P1",
      "text": "存在一个标签，且该标签已被至少一个任务引用（即任务创建时选择了该标签）"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理列表页，找到该已被任务使用的标签；"
    },
    {
      "id": "S2",
      "text": "点击该标签对应的【禁用】按钮；"
    },
    {
      "id": "S3",
      "text": "观察页面提示。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "列表页正常显示该标签；"
    },
    {
      "id": "A2",
      "text": "系统弹出提示或显示错误信息；"
    },
    {
      "id": "A3",
      "text": "提示内容为：“标签已被任务使用，不允许禁用”，且该标签状态未被禁用，仍保持启用状态。"
    }
  ],
  "contractHash": "83b5130309376623f4502a540f2ab9c63d9b5f55228b6ae15574a6feff6af5cd",
  "completionGate": {
    "requiredCoverageIds": [
