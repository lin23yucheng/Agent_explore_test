  "title": "标签管理 - 编辑标签名称支持中英文字母和数字",
  "preconditions": [
    {
      "id": "P1",
      "text": "存在一个已创建的标签，未被任何任务使用"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理列表页，点击目标标签的“编辑”按钮。"
    },
    {
      "id": "S2",
      "text": "在标签名称输入框中输入“标签ABC123”。"
    },
    {
      "id": "S3",
      "text": "点击“确定”保存。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "编辑弹窗打开，标签名称输入框可编辑。"
    },
    {
      "id": "A2",
      "text": "输入内容“标签ABC123”被接受。"
    },
    {
      "id": "A3",
      "text": "保存成功，列表页显示标签名称“标签ABC123”。"
    }
  ],
