  "title": "标签管理 - 验证标签名称长度为32时创建成功",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录系统且具有标签管理权限的用户"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理页面，点击“新建标签”按钮。"
    },
    {
      "id": "S2",
      "text": "在标签名称输入框中输入长度为32的合法字符（如“abcdefghijklmnopqrstuvwxyz123456”）。"
    },
    {
      "id": "S3",
      "text": "选择分类为“其他”。"
    },
    {
      "id": "S4",
      "text": "点击“确定”提交。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "弹出新建标签对话框。"
    },
    {
      "id": "A2",
      "text": "输入成功，无长度错误提示。"
    },
    {
      "id": "A3",
      "text": "分类选择成功。"
    },
    {
      "id": "A4",
      "text": "标签创建成功，列表中出现该标签，名称显示为输入的32位字符。"
    }
  ],
