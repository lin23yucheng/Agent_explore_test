{
  "schemaVersion": 1,
  "caseId": "CASE-000444",
  "caseContentHash": "1dea8e89202c8240f550da6fcf1bb1ab9d54b51ef3c6caa5f3ca058df3048c75",
  "title": "标签管理 - 编辑标签名称为32个字符的边界值",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录系统且具有标签管理权限；存在一个已创建的标签，名称为“测试标签”，状态为启用；该标签未被任何任务使用。"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理列表页，找到目标标签“测试标签”。"
    },
    {
      "id": "S2",
      "text": "点击该标签所在行的“编辑”按钮。"
    },
    {
      "id": "S3",
      "text": "在编辑弹窗中，将标签名称修改为“12345678901234567890123456789012”。"
    },
    {
      "id": "S4",
      "text": "点击“确定”或“保存”按钮。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "标签管理列表页正常显示，目标标签可见。"
    },
    {
      "id": "A2",
      "text": "弹出编辑弹窗，标签名称输入框可编辑。"
    },
    {
      "id": "A3",
      "text": "输入框内容变为“12345678901234567890123456789012”。"
    },
    {
      "id": "A4",
      "text": "保存成功，列表页显示更新后的标签名称“12345678901234567890123456789012”。"
    }
  ],
  "contractHash": "b2d520963ac718aa8612f898f24c279cbce2994248d9e2086c986e7fafa3e995",
  "completionGate": {
    "requiredCoverageIds": [
      "P1",
      "S1",
      "S2",
      "S3",
      "S4",
      "A1",
      "A2",
      "A3",
      "A4"
    ],
    "passRequiresCompleteCoverage": true
  }
}