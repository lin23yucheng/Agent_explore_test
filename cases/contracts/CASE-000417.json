  "caseContentHash": "ccbc728d52269cbbc50db24bf977a5c1b273846a3ed8f4084473cf9fe09d4bde",
  "title": "标签管理 - 新建标签时选择质量分类成功",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录系统且具有标签管理权限；标签管理页面可访问；不存在同名标签"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理页面，点击“新建标签”按钮；"
    },
    {
      "id": "S2",
      "text": "在标签名称输入框中输入“质量标签”；"
    },
    {
      "id": "S3",
      "text": "在标签分类下拉框中选择“质量”；"
    },
    {
      "id": "S4",
      "text": "点击“确定”或“保存”按钮。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "弹出新建标签对话框或进入新建标签页面；"
    },
    {
      "id": "A2",
      "text": "标签名称输入成功；"
    },
    {
      "id": "A3",
      "text": "分类选择为“质量”；"
    },
    {
      "id": "A4",
      "text": "标签创建成功，列表中出现该标签，分类显示为“质量”。"
    }
  ],
  "contractHash": "91bcfc9def3adf3a21fb32b4e105dacb7c47dde6b6179e5705ae94780965a33c",
  "completionGate": {
