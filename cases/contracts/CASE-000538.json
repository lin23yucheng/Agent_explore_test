  "title": "标签管理 - 编辑标签名称唯一性校验提示",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录系统且具有标签管理权限；存在两个标签，标签A名称为“标签A”，标签B名称为“标签B”；当前编辑标签A"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理列表页，找到标签A所在行，点击“编辑”按钮。"
    },
    {
      "id": "S2",
      "text": "在编辑弹窗中，将标签名称输入框内容修改为“标签B”（与已有标签B重名）。"
    },
    {
      "id": "S3",
      "text": "点击“确定”或“保存”按钮。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "编辑弹窗打开，标签名称输入框回显“标签A”。"
    },
    {
      "id": "A2",
      "text": "输入框内容变为“标签B”。"
    },
    {
      "id": "A3",
      "text": "系统提示“标签名已存在”，输入框不报红，保存操作被阻止，标签A名称仍为“标签A”。"
    }
  ],
  "contractHash": "1c3faa9feae45f95e1ee7a62f5be03a98058630c37a6b9ecf1f1bc04db878620",
  "completionGate": {
    "requiredCoverageIds": [
      "P1",
