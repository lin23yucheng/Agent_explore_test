{
  "schemaVersion": 1,
  "caseId": "CASE-000442",
  "caseContentHash": "b1eb65c21644274384df56d8f90a37fe6423aaa3537d82ba54e04eab6cc7b4d8",
  "title": "标签管理 - 编辑标签名称回显并修改为合法值",
  "preconditions": [
    {
      "id": "P1",
      "text": "已登录系统且具有标签管理权限；存在一个已创建的标签，名称为“测试标签”，状态为启用；该标签未被任何任务使用。"
    }
  ],
  "steps": [
    {
      "id": "S1",
      "text": "进入标签管理列表页，找到目标标签“测试标签”。"
    },
    {
      "id": "S2",
      "text": "点击该标签所在行的“编辑”按钮。"
    },
    {
      "id": "S3",
      "text": "在编辑弹窗中确认标签名称输入框回显为“测试标签”。"
    },
    {
      "id": "S4",
      "text": "将标签名称修改为“新标签名”。"
    },
    {
      "id": "S5",
      "text": "点击“确定”或“保存”按钮。"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "text": "标签管理列表页正常显示，目标标签可见。"
    },
    {
      "id": "A2",
      "text": "弹出编辑弹窗，标签名称输入框可编辑。"
    },
    {
      "id": "A3",
      "text": "标签名称输入框回显“测试标签”。"
    },
    {
      "id": "A4",
      "text": "输入框内容变为“新标签名”。"
    },
    {
      "id": "A5",
      "text": "保存成功，列表页显示更新后的标签名称“新标签名”。"
    }
  ],
  "contractHash": "21d51fd85a182313dd5a4522b91be4a820171497153abc36627bcc99c9ecc579",
  "completionGate": {
    "requiredCoverageIds": [
